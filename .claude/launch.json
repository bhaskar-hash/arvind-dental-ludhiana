{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@redcity/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "portal",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@redcity/portal",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/api && source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "whatsapp-guide",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4100",
        "--directory",
        "guides/redcity-whatsapp-guide"
      ],
      "port": 4100
    },
    {
      "name": "ai-image-prompts",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4101",
        "--directory",
        "guides/redcity-ai-image-prompts"
      ],
      "port": 4101
    }
  ]
}
